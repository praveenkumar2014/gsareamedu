{
  "name": "guidesoft-education-ai",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/web -H 0.0.0.0",
    "build": "next build apps/web",
    "start": "next start apps/web -H 0.0.0.0",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint apps/web packages tests scripts --ext .ts,.tsx,.js,.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:validate": "drizzle-kit check",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "next-auth": "4.24.15",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.19.3",
    "@types/pg": "8.15.6",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.22",
    "drizzle-kit": "0.31.11",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.18",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.33",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "tsx": {
      "esbuild": "0.28.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
